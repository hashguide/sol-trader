{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n engine,web -c blue,green \"npm run dev:engine\" \"npm run dev:web\"",
    "dev:engine": "tsx watch engine/main.ts",
    "dev:web": "next dev --hostname 127.0.0.1 --port 4472",
    "build": "esbuild engine/main.ts --bundle --platform=node --format=esm --outfile=dist/engine.js --packages=external && esbuild engine/docker-entry.ts --bundle --platform=node --format=esm --outfile=dist/docker-entry.js --packages=external && next build",
    "start": "node dist/docker-entry.js",
    "start:engine": "node dist/engine.js",
    "start:web": "next start --hostname ${WEB_BIND:-127.0.0.1} --port ${WEB_PORT:-4472}",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.engine.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backtest": "tsx engine/cli/backtest.ts",
    "paper:smoke": "tsx engine/cli/paper-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.16",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.68.0",
    "next": "15.5.29",
    "pino": "^10.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
