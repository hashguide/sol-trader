# Paper is the default. Live refuses to start unless every trading chain has a key.
TRADING_MODE=paper
# Resume the loop on process start after a dashboard password exists.
ENGINE_AUTOSTART=false
# Optional. If unset, the first visit to the desk sets the password.
# DASHBOARD_PASSWORD=
# 32-byte hex. If unset, data/secrets.key is created on first start (mode 0600).
# SECRETS_KEY=
PAPER_STARTING_EQUITY_USD=10000
LOOP_INTERVAL_MS=60000
ENGINE_BIND=127.0.0.1
WEB_BIND=127.0.0.1
ENGINE_PORT=4471
WEB_PORT=4472
DATA_DIR=./data
# Holding kill. A file named data/KILL does the same and cannot be cleared from the desk.
KILL_SWITCH=false
# Bypasses promotion gates for live entries. Leave false.
LIVE_OVERRIDE_GATES=false
LOG_LEVEL=info

# Alerts. Either pair is enough. Discord webhooks are detected by URL.
# ALERT_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional. Quotes work without these. api.jup.ag requires JUPITER_API_KEY; the lite host does not.
# JUPITER_API_KEY=
# JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
# JITO_BLOCK_ENGINE_URL=
# FLASHBOTS_PROTECT=true
# ZEROX_API_KEY is reserved. Direct Uniswap v3 and Aerodrome are what the engine sends.
# BIRDEYE_API_KEY is reserved. Candles come from GeckoTerminal, with DexScreener as the mark.

# Dedicated hot-wallet keys. Never commit real values. The desk can store a key instead; it is encrypted and not shown again.
# SOLANA_PRIVATE_KEY=
# EVM_PRIVATE_KEY=
# ETHEREUM_PRIVATE_KEY=
# BASE_PRIVATE_KEY=
# ARBITRUM_PRIVATE_KEY=
# ROBINHOOD_PRIVATE_KEY=

# Empty values are skipped. Lower priority number is preferred.
# RPC_SOLANA_QUICKNODE=
# RPC_SOLANA_ALCHEMY=
# RPC_SOLANA_INFURA=
# RPC_ETHEREUM_QUICKNODE=
# RPC_ETHEREUM_ALCHEMY=
# RPC_ETHEREUM_INFURA=
# RPC_BASE_QUICKNODE=
# RPC_BASE_ALCHEMY=
# RPC_BASE_INFURA=
# RPC_ARBITRUM_QUICKNODE=
# RPC_ARBITRUM_ALCHEMY=
# RPC_ARBITRUM_INFURA=
# RPC_ROBINHOOD_QUICKNODE=
# RPC_ROBINHOOD_ALCHEMY=
# RPC_ROBINHOOD_INFURA=
